{
    "manifest_version":  3,
    "name":  "Browser MCP Core Connector",
    "version":  "0.1.1",
    "description":  "Bridges browser tabs to a local MCP host over native messaging.",
    "minimum_chrome_version":  "116",
    "permissions":  [
                        "nativeMessaging",
                        "debugger",
                        "tabs",
                        "tabGroups",
                        "storage",
                        "alarms"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "background":  {
                       "service_worker":  "background.js",
                       "type":  "module"
                   },
    "action":  {
                   "default_title":  "Browser MCP Core"
               },
    "key":  ""
}
