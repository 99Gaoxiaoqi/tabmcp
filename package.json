{
  "name": "@local/tabmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that drives a real browser tab: ARIA snapshots, opaque refs, adapters and a REPL.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "chrome-extension",
    "cdp",
    "playwright",
    "aria"
  ],
  "homepage": "https://github.com/99Gaoxiaoqi/tabmcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99Gaoxiaoqi/tabmcp.git"
  },
  "bugs": {
    "url": "https://github.com/99Gaoxiaoqi/tabmcp/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tabmcp": "dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test-count.mjs && node --test dist/tests/*.test.js",
    "verify": "node scripts/lockfile-check.mjs && node scripts/generate-host-config.mjs --check && node scripts/leak-scan.mjs && node scripts/name-check.mjs && node scripts/tool-count.mjs && npm run typecheck && npm run build && node scripts/build-completeness.mjs && npm test",
    "setup:extension": "node scripts/generate-host-config.mjs && node scripts/setup-extension.mjs",
    "lockfile-check": "node scripts/lockfile-check.mjs",
    "build:launcher": "node scripts/build-launcher.mjs",
    "doctor:host": "node scripts/doctor-host.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
